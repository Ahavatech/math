generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users and access
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  HOD
  ADMIN
  LECTURER
  JOURNAL_EDITOR_IN_CHIEF
  JOURNAL_EDITOR
  REVIEWER
  AUTHOR
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFY
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String?
  passwordChangedAt DateTime?
  emailVerifiedAt   DateTime?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles  UserRole[]
  tokens UserToken[]

  lecturerProfile LecturerProfile?

  updatedSiteSettings         SiteSetting[]       @relation("SiteSettingUpdatedBy")
  uploadedMedia               MediaAsset[]        @relation("MediaUploadedBy")
  contentRevisions            ContentRevision[]   @relation("ContentRevisionCreatedBy")
  auditLogs                   AuditLog[]          @relation("AuditLogActor")
  createdAlumniLinks          AlumniLink[]        @relation("AlumniLinkCreatedBy")
  reviewedAlumniEntries       AlumniEntry[]       @relation("AlumniEntryReviewedBy")
  uploadedDownloads           Download[]          @relation("DownloadUploadedBy")
  authoredNewsPosts           NewsPost[]          @relation("NewsPostAuthor")
  submittedManuscripts        Manuscript[]        @relation("ManuscriptSubmittedBy")
  handledManuscripts          Manuscript[]        @relation("ManuscriptHandlingEditor")
  uploadedManuscriptFiles     ManuscriptFile[]    @relation("ManuscriptFileUploadedBy")
  manuscriptEvents            ManuscriptEvent[]   @relation("ManuscriptEventActor")
  reviewAssignments           ReviewAssignment[]  @relation("ReviewAssignmentReviewer")
  reviewAssignmentsInvited    ReviewAssignment[]  @relation("ReviewAssignmentInvitedBy")
  editorialDecisions          EditorialDecision[] @relation("EditorialDecisionEditor")
  articleAuthorLinks          ArticleAuthor[]     @relation("ArticleAuthorUser")
  reviewerProfile             ReviewerProfile?    @relation("ReviewerProfileUser")

  @@index([isActive])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

model UserToken {
  id        String        @id @default(cuid())
  userId    String
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Site content
// ---------------------------------------------------------------------------

enum NavLocation {
  HEADER
  FOOTER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactMessageType {
  ADMISSIONS
  RESEARCH
  COLLABORATION
  ALUMNI
  GENERAL
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model NavItem {
  id        String      @id @default(cuid())
  label     String
  href      String
  parentId  String?
  location  NavLocation
  order     Int         @default(0)
  isVisible Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   NavItem?  @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavItemChildren")

  @@index([location, order])
}

model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  body      String
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model MediaAsset {
  id           String   @id @default(cuid())
  provider     String
  publicId     String
  url          String
  width        Int?
  height       Int?
  bytes        Int?
  format       String?
  alt          String?
  deliveryType String   @default("upload") // "upload" (public) or "authenticated" (pending alumni photos)
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User? @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  researchAreaImages   ResearchArea[]         @relation("ResearchAreaImage")
  lecturerPhotos       LecturerProfile[]      @relation("LecturerPhoto")
  nonTeachingPhotos    NonTeachingStaff[]     @relation("NonTeachingPhoto")
  newsPostCovers       NewsPost[]             @relation("NewsPostCover")
  eventFlyers          Event[]                @relation("EventFlyer")
  eventGalleryImages   EventGalleryImage[]    @relation("EventGalleryMedia")
  alumniPhotos         AlumniEntry[]          @relation("AlumniPhoto")
  journalIssueCovers   JournalIssue[]         @relation("JournalIssueCover")
  downloads            Download[]             @relation("DownloadMedia")
  editorialBoardPhotos EditorialBoardMember[] @relation("EditorialBoardMemberPhoto")

  @@index([provider, publicId])
}

model ContentRevision {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  snapshot    Json
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation("ContentRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  summary    String
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  type      ContactMessageType
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Academics
// ---------------------------------------------------------------------------

enum ProgrammeLevel {
  BSC
  MSC
  PHD
}

enum Semester {
  FIRST
  SECOND
}

model Programme {
  id                    String         @id @default(cuid())
  slug                  String         @unique
  level                 ProgrammeLevel
  title                 String
  summary               String
  body                  String
  duration              String
  admissionRequirements String
  order                 Int            @default(0)
  status                ContentStatus  @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  specialisations Specialisation[]

  @@index([status])
  @@index([level])
}

model Specialisation {
  id          String   @id @default(cuid())
  programmeId String
  title       String
  description String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@index([programmeId])
}

model ResearchArea {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String
  body      String
  imageId   String?
  order     Int           @default(0)
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  image     MediaAsset?       @relation("ResearchAreaImage", fields: [imageId], references: [id], onDelete: SetNull)
  lecturers LecturerProfile[] @relation("LecturerResearchArea")

  @@index([status])
}

model Course {
  id             String         @id @default(cuid())
  code           String         @unique
  slug           String         @unique
  title          String
  units          Int
  level          Int
  semester       Semester
  programmeLevel ProgrammeLevel
  isElective     Boolean        @default(false)
  description    String
  searchText     String         @default("")
  status         ContentStatus  @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  prerequisites Course[] @relation("CoursePrerequisite")
  requiredFor   Course[] @relation("CoursePrerequisite")

  lecturers LecturerProfile[] @relation("CourseLecturer")

  @@index([status])
  @@index([semester])
  @@index([programmeLevel])
}

model HandbookPage {
  id            String        @id @default(cuid())
  slug          String        @unique
  previousSlugs String[]      @default([])
  title         String
  summary       String?
  body          String
  searchText    String        @default("")
  parentId      String?
  order         Int           @default(0)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parent   HandbookPage?  @relation("HandbookPageChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children HandbookPage[] @relation("HandbookPageChildren")

  @@index([status])
}

model Download {
  id           String        @id @default(cuid())
  title        String
  description  String?
  category     String
  mediaId      String?
  fileUrl      String?
  filePublicId String?
  fileSize     Int?
  order        Int           @default(0)
  status       ContentStatus @default(DRAFT)
  uploadedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  media      MediaAsset? @relation("DownloadMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  uploadedBy User?       @relation("DownloadUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  lecturerCvFor LecturerProfile[] @relation("LecturerCv")
  articlePdfFor Article[]         @relation("ArticlePdf")

  @@index([status, category])
}

model AcademicCalendarEntry {
  id          String    @id @default(cuid())
  session     String
  title       String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startDate])
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum LecturerRank {
  PROFESSOR
  ASSOCIATE_PROFESSOR
  SENIOR_LECTURER
  LECTURER_I
  LECTURER_II
  ASSISTANT_LECTURER
  GRADUATE_ASSISTANT
  OTHER
}

model LecturerProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  slug               String        @unique
  fullName           String
  honorific          String?
  rank               LecturerRank
  photoId            String?
  bio                String?
  officeLocation     String?
  officeHours        String?
  publicEmail        String?
  phone              String?
  scholarUrl         String?
  orcid              String?
  researchGateUrl    String?
  linkedinUrl        String?
  cvDownloadId       String?
  isEmeritus         Boolean       @default(false)
  order              Int           @default(0)
  status             ContentStatus @default(DRAFT)
  previousSlugs      String[]      @default([])
  supervisionText    String?
  publishRequestedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo      MediaAsset? @relation("LecturerPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  cvDownload Download?   @relation("LecturerCv", fields: [cvDownloadId], references: [id], onDelete: SetNull)

  researchAreas ResearchArea[] @relation("LecturerResearchArea")
  courses       Course[]       @relation("CourseLecturer")
  publications  Publication[]

  editorialBoardMemberships EditorialBoardMember[]

  @@index([status, rank])
}

model Publication {
  id          String   @id @default(cuid())
  lecturerId  String
  title       String
  authorsText String
  venue       String?
  year        Int
  url         String?
  doi         String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lecturer LecturerProfile @relation(fields: [lecturerId], references: [id], onDelete: Cascade)

  @@index([lecturerId])
}

model NonTeachingStaff {
  id          String   @id @default(cuid())
  name        String
  position    String
  photoId     String?
  email       String?
  phone       String?
  showContact Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photo MediaAsset? @relation("NonTeachingPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// News and events
// ---------------------------------------------------------------------------

enum NewsCategory {
  ANNOUNCEMENT
  ACHIEVEMENT
  ADMISSION
  RESEARCH
}

enum EventType {
  SEMINAR
  COLLOQUIUM
  SPECIAL_LECTURE
  CONFERENCE
  GRADUATION
  OTHER
}

model NewsPost {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  category      NewsCategory
  excerpt       String?
  body          String
  coverId       String?
  isPinned      Boolean       @default(false)
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?
  previousSlugs String[]      @default([])
  authorId      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cover  MediaAsset? @relation("NewsPostCover", fields: [coverId], references: [id], onDelete: SetNull)
  author User?       @relation("NewsPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([category])
  @@index([isPinned])
}

model EventSeries {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events Event[]
}

model Event {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  type               EventType
  startsAt           DateTime
  endsAt             DateTime?
  venue              String?
  speakerName        String?
  speakerAffiliation String?
  description        String?
  flyerId            String?
  registrationUrl    String?
  slidesUrl          String?
  recordingUrl       String?
  seriesId           String?
  status             ContentStatus @default(DRAFT)
  previousSlugs      String[]      @default([])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  flyer  MediaAsset?  @relation("EventFlyer", fields: [flyerId], references: [id], onDelete: SetNull)
  series EventSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  galleryImages EventGalleryImage[]

  @@index([status, startsAt])
  @@index([type])
}

model EventGalleryImage {
  id        String   @id @default(cuid())
  eventId   String
  mediaId   String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media MediaAsset @relation("EventGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Alumni
// ---------------------------------------------------------------------------

enum AlumniLevel {
  BSC
  MSC
}

enum AlumniStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model AlumniLink {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  label       String
  cohortYear  Int?
  expiresAt   DateTime
  maxUses     Int?
  useCount    Int       @default(0)
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy User?         @relation("AlumniLinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  entries   AlumniEntry[]

  @@index([isActive, expiresAt])
}

model AlumniEntry {
  id              String       @id @default(cuid())
  fullName        String
  email           String
  level           AlumniLevel
  graduationYear  Int
  organisation    String?
  roleTitle       String?
  city            String?
  country         String?
  industry        String?
  photoId         String?
  linkedinUrl     String?
  consentAt       DateTime
  consentVersion  String
  status          AlumniStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?
  linkId          String?
  dedupeKey       String
  isFeatured      Boolean      @default(false)
  withdrawnAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  photo      MediaAsset? @relation("AlumniPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  reviewedBy User?       @relation("AlumniEntryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  link       AlumniLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([dedupeKey])
  @@index([graduationYear])
}

model AlumniReferenceRecord {
  id             String      @id @default(cuid())
  fullName       String
  level          AlumniLevel
  graduationYear Int
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([graduationYear])
}

// ---------------------------------------------------------------------------
// Journal
// ---------------------------------------------------------------------------

enum ManuscriptStatus {
  INCOMPLETE
  SUBMITTED
  SCREENING
  UNDER_REVIEW
  REVISION_REQUESTED
  RETURNED_TO_AUTHOR
  ACCEPTED
  REJECTED
  WITHDRAWN
  PUBLISHED
}

enum ReviewAssignmentStatus {
  INVITED
  ACCEPTED
  DECLINED
  SUBMITTED
  EXPIRED
  REVOKED
}

enum ReviewRecommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum EditorialDecisionType {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
  DESK_REJECT
}

enum ManuscriptFileKind {
  MANUSCRIPT
  TITLE_PAGE
  SUPPLEMENTARY
  RESPONSE_TO_REVIEWERS
  REVISED
  COPYEDITED
  REVIEW_ATTACHMENT
}

model JournalIssue {
  id          String        @id @default(cuid())
  volume      Int
  number      Int
  year        Int
  title       String?
  description String?
  coverId     String?
  publishedAt DateTime?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cover    MediaAsset? @relation("JournalIssueCover", fields: [coverId], references: [id], onDelete: SetNull)
  articles Article[]

  @@unique([volume, number])
  @@index([status, publishedAt])
}

enum ArticleType {
  RESEARCH_ARTICLE
  REVIEW
  SHORT_COMMUNICATION
  OTHER
}

model Article {
  id            String        @id @default(cuid())
  slug          String        @unique
  previousSlugs String[]      @default([])
  title         String
  abstract      String
  keywords      String[]
  searchText    String        @default("")
  issueId       String?
  pageStart     Int?
  pageEnd       Int?
  type          ArticleType   @default(RESEARCH_ARTICLE)
  pdfDownloadId String?
  doi           String?
  license       String?
  receivedAt    DateTime?     @db.Date
  acceptedAt    DateTime?     @db.Date
  publishedAt   DateTime?
  status        ContentStatus @default(DRAFT)
  manuscriptId  String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  issue      JournalIssue? @relation(fields: [issueId], references: [id], onDelete: Restrict)
  pdf        Download?     @relation("ArticlePdf", fields: [pdfDownloadId], references: [id], onDelete: SetNull)
  manuscript Manuscript?   @relation(fields: [manuscriptId], references: [id], onDelete: SetNull)

  authors ArticleAuthor[]

  @@index([status, publishedAt])
}

model ArticleAuthor {
  id          String   @id @default(cuid())
  articleId   String
  name        String
  affiliation String?
  orcid       String?
  email       String?
  order       Int      @default(0)
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation("ArticleAuthorUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([articleId])
}

model EditorialBoardMember {
  id                 String   @id @default(cuid())
  lecturerProfileId  String?
  name               String
  roleTitle          String
  affiliation        String?
  affiliationCountry String?
  orcid              String?
  externalUrl        String?
  photoId            String?
  order              Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lecturerProfile LecturerProfile? @relation(fields: [lecturerProfileId], references: [id], onDelete: SetNull)
  photo           MediaAsset?      @relation("EditorialBoardMemberPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

model Manuscript {
  id                     String           @id @default(cuid())
  reference              String?          @unique
  title                  String
  abstract               String
  keywords               String[]
  articleType            ArticleType      @default(RESEARCH_ARTICLE)
  coverLetter            String?
  suggestedReviewers     Json?
  excludedReviewers      Json?
  anonymisedConfirmedAt  DateTime?
  agreementVersion       String?
  agreementAcceptedAt    DateTime?
  submittedAt            DateTime?
  status                 ManuscriptStatus @default(INCOMPLETE)
  submittedById          String?
  handlingEditorId       String?
  currentRound           Int              @default(1)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  submittedBy    User? @relation("ManuscriptSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  handlingEditor User? @relation("ManuscriptHandlingEditor", fields: [handlingEditorId], references: [id], onDelete: SetNull)

  authors            ManuscriptAuthor[]
  rounds             ManuscriptRound[]
  files              ManuscriptFile[]
  events             ManuscriptEvent[]
  reviewAssignments  ReviewAssignment[]
  editorialDecisions EditorialDecision[]
  article            Article?

  @@index([status])
  @@index([submittedById])
  @@index([handlingEditorId])
}

model ManuscriptAuthor {
  id              String   @id @default(cuid())
  manuscriptId    String
  name            String
  affiliation     String?
  email           String?
  isCorresponding Boolean  @default(false)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)

  @@index([manuscriptId])
}

model ManuscriptRound {
  id           String   @id @default(cuid())
  manuscriptId String
  number       Int
  submittedAt  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)

  files              ManuscriptFile[]
  reviewAssignments  ReviewAssignment[]
  editorialDecisions EditorialDecision[]

  @@unique([manuscriptId, number])
}

model ManuscriptFile {
  id           String             @id @default(cuid())
  manuscriptId String
  roundId      String?
  kind         ManuscriptFileKind
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  sha256       String
  uploadedById String?
  createdAt    DateTime           @default(now())

  manuscript Manuscript       @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  round      ManuscriptRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  uploadedBy User?            @relation("ManuscriptFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([manuscriptId])
  @@index([roundId])
}

model ReviewAssignment {
  id            String                 @id @default(cuid())
  manuscriptId  String
  roundId       String
  reviewerId    String
  status        ReviewAssignmentStatus @default(INVITED)
  invitedAt     DateTime               @default(now())
  respondedAt   DateTime?
  dueAt         DateTime?
  invitedById   String?
  tokenHash     String?                @unique
  declineReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  manuscript      Manuscript          @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  round           ManuscriptRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  reviewer        User                @relation("ReviewAssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  invitedBy       User?               @relation("ReviewAssignmentInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  review          Review?
  reminderLogs    ReviewReminderLog[]

  @@unique([manuscriptId, roundId, reviewerId])
  @@index([reviewerId, status])
  @@index([invitedById])
}

model Review {
  id                   String               @id @default(cuid())
  assignmentId         String               @unique
  recommendation       ReviewRecommendation?
  commentsToAuthor     String?
  commentsToAuthorHtml String?
  commentsToEditor     String?
  commentsToEditorHtml String?
  isDraft              Boolean              @default(true)
  submittedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

model EditorialDecision {
  id           String                @id @default(cuid())
  manuscriptId String
  roundId      String
  editorId     String
  decision     EditorialDecisionType
  letter       String?
  letterHtml   String?
  decidedAt    DateTime              @default(now())
  emailSentAt  DateTime?
  createdAt    DateTime              @default(now())

  manuscript Manuscript      @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  round      ManuscriptRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  editor     User            @relation("EditorialDecisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@index([manuscriptId])
}

enum ManuscriptEventType {
  CREATED
  SUBMITTED
  FILE_ADDED
  FILE_REMOVED
  EDITOR_ASSIGNED
  RETURNED_TO_AUTHOR
  RESUBMITTED
  DESK_REJECTED
  APPROVED_FOR_REVIEW
  WITHDRAWN
  INTERNAL_NOTE
  REVIEWER_INVITED
  REVIEWER_ACCEPTED
  REVIEWER_DECLINED
  REVIEWER_REVOKED
  REVIEWER_EXPIRED
  REVIEWER_REMINDER_SENT
  REVIEW_SUBMITTED
  DECISION_RECORDED
  REVISION_REQUESTED
  ROUND_CREATED
}

model ManuscriptEvent {
  id              String              @id @default(cuid())
  manuscriptId    String
  type            ManuscriptEventType
  actorId         String?
  visibleToAuthor Boolean             @default(false)
  note            String?
  createdAt       DateTime            @default(now())

  manuscript Manuscript @relation(fields: [manuscriptId], references: [id], onDelete: Cascade)
  actor      User?      @relation("ManuscriptEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([manuscriptId, createdAt])
}

model JournalCounter {
  year  Int @id
  value Int
}

model ReviewerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  expertiseTags String[] @default([])
  isActive      Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation("ReviewerProfileUser", fields: [userId], references: [id], onDelete: Cascade)
}

/// Tracks which milestone reminders have been sent for a review assignment.
/// Ensures the reminders script is idempotent: same milestone is never emailed twice.
model ReviewReminderLog {
  id           String   @id @default(cuid())
  assignmentId String
  milestone    String
  sentAt       DateTime @default(now())
  createdAt    DateTime @default(now())

  assignment ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, milestone])
  @@index([assignmentId])
}

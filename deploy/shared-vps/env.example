# Copy to /etc/oaumaths/env on the VPS (root:maths, mode 640). Never commit real values.
# Plain KEY=VALUE lines only, no quotes and no "export".

NODE_ENV=production
PORT=3100
HOSTNAME=127.0.0.1

# Local PostgreSQL (see step 4 of DEPLOY-SHARED.md)
DATABASE_URL=postgresql://oaumaths:CHANGE_ME@127.0.0.1:5432/oaumaths

# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# The public address. These two are baked into the build, so rebuild after changing them.
AUTH_URL=https://oaumaths.online
NEXT_PUBLIC_SITE_URL=https://oaumaths.online

# First SUPER_ADMIN created by the seed
SEED_ADMIN_EMAIL=CHANGE_ME@example.com

# Private manuscripts and reviewer reports (outside the web root)
PRIVATE_STORAGE_DIR=/var/private-storage

# Resend: placeholders let the app start, but no email is sent until real values are set
EMAIL_FROM=noreply@oaumaths.online
RESEND_API_KEY=placeholder-replace-me

# Cloudinary: placeholders let the app start, but uploads fail until real values are set
CLOUDINARY_CLOUD_NAME=placeholder
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Used by deploy/backup-scripts/daily-backup.sh
BACKUP_DIR=/var/backups/oaumaths
BACKUP_RETENTION_DAYS=14

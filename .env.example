# Required now.
# PostgreSQL connection string, e.g. postgresql://postgres:postgres@localhost:5432/oau_maths?schema=public
# Matches the local database started by docker-compose.yml.
DATABASE_URL=

# Optional. A separate PostgreSQL database used only by the Vitest suites
# in tests/unit/database. Migrations are applied to it before tests run;
# never point this at a database with data you care about.
TEST_DATABASE_URL=

# Optional for now, required for `npm run db:seed` to create a usable
# super admin. Stage 03's invite flow sets this user's password.
SEED_ADMIN_EMAIL=

# Optional for now, required once Auth.js is added (Stage 03).
AUTH_SECRET=
AUTH_URL=

# Optional for now, required once Cloudinary is added (Stage 05).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional for now, required once Resend is added (Stage 03/09).
RESEND_API_KEY=
EMAIL_FROM=

# Optional for now. Absolute path, outside the web root, where private
# manuscripts and reviewer reports are stored (Stage 11/12).
PRIVATE_STORAGE_DIR=

# Optional for now. Public site URL used for absolute links in emails
# and metadata.
NEXT_PUBLIC_SITE_URL=
